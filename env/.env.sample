## for timezone, check this link: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

APP_PORT=
APP_MAX_BODY_SIZE=
APP_TRUST_PROXY_HOPS=
APP_PREFIX=
APP_NAME=
NODE_ENV=
API_URL=
CLIENT_URL=
SWAGGER_USER=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
SWAGGER_PASSWORD=
TZ=

	# database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_POOL_MIN=
DB_POOL_MAX=

  # seeder credential (passed on the command line; never logged)
USER_PASSWORD=


  # encryption
ENC_IV=
ENC_KEY=


  # jwt
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=
JWT_SECRET=
MAGIC_LINK_EXPIRY=

  # mail
MAIL_HOST=
MAIL_PASSWORD=
MAIL_USERNAME=
MAIL_PORT=
MAIL_SERVER=
MAIL_PREVIEW_EMAIL=
MAIL_SENDER_EMAIL=
MAIL_TEMPLATE_DIR=


  # cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

  # redis
REDIS_TTL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=


  # rabbitmq
RABBITMQ_EXCHANGE=
RABBITMQ_DEFAULT_PREFETCH=
RABBITMQ_URI=


  #google ouath
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=



  #facebook ouath
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=


  #throttle
THROTTLE_LIMIT=
THROTTLE_TTL=

  # cache (optional)
# Set in production so ?clearCache=true requires a token; unset disables the guard.
CACHE_CLEAR_TOKEN=

  #stripe (optional)
STRIPE_API_KEY=
STRIPE_ACCOUNT=
STRIPE_CONNECT=


  #sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=


  #twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=


  #minio (optional)
MINIO_HOST=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=

  #storage s3 (optional)
# Set STORAGE_DRIVER=s3 to use S3-compatible storage for uploaded files.
# When enabled, the following S3 variables are required:
# STORAGE_DRIVER=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
