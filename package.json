{
  "name": "ultimate-nest",
  "version": "2.9.1",
  "description": "NestJS + MikroORM blog example with batteries included",
  "keywords": [
    "casl",
    "jest",
    "jsonwebtoken",
    "jwt",
    "mikroorm",
    "nest",
    "nest.js",
    "nestjs",
    "nestjs-boilerplate",
    "nestjs-mikroorm",
    "nestjs-starter-template",
    "nestjs-template",
    "node",
    "node.js",
    "nodejs",
    "orm",
    "passport",
    "swagger",
    "typescript"
  ],
  "homepage": "https://github.com/rubiin/ultimate-nest#readme",
  "bugs": "https://github.com/rubiin/ultimate-nest/issues",
  "license": "MIT",
  "author": {
    "name": "Rubin Bhandari",
    "email": "roobin.bhandari@gmail.com",
    "url": "https://rubiin.vercel.app"
  },
  "repository": "https://github.com/rubiin/ultimate-nest",
  "scripts": {
    "build": "nest build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "orm": "npx mikro-orm",
    "sample": "cd env; npx  sample-env --env .env.dev",
    "start": "nest start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start:dev": "nest start --watch",
    "start:hmr": "nest build --watch --webpack --webpackPath webpack-hmr.js",
    "start:prod": "node dist/main",
    "start:repl": "MIKRO_ORM_ALLOW_GLOBAL_CONTEXT=true nest start --watch --entryFile repl",
    "start:debug": "NEST_DEBUG=true nest start --debug --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
