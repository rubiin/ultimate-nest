    "@mikro-orm/reflection": "^7.2.5",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/i18n": "^0.0.2",
