    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-stats": "^0.95.11",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "run-script-webpack-plugin": "^0.2.3",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "mikro-orm": {
    "preferTs": true,
    "tsLoader": "tsx",
    "configPaths": [
      "./src/common/database/mikro-orm-cli.config.ts",
      "./dist/common/database/mikro-orm-cli.config.js"
    ]
  }
}
