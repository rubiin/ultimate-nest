    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/seeder": "^7.2.5",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@rspack/core": "^2.2.9",
