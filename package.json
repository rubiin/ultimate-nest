    "mime": "^4.1.2",
    "nestjs-cloudinary": "^2.5.0",
    "nestjs-minio": "^2.8.2",
    "nestjs-pino": "^5.3.1",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
